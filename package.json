{
  "name": "proveeeventos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "env:init": "bash scripts/dev/gen-env.sh",
    "dc": "docker compose --env-file docker/images.env --env-file .env",
    "dev": "npm run dev:watch",
    "dev:up": "npm run dc -- --profile dev up -d --build --wait",
    "dev:watch": "npm run dc -- --profile dev up --build --watch",
    "dev:ps": "npm run dc -- --profile dev ps -a",
    "dev:logs": "npm run dc -- --profile dev logs -f --tail=200",
    "dev:down": "npm run dc -- --profile dev down",
    "dev:reset": "npm run dc -- --profile dev --profile test --profile tools down -v --remove-orphans",
    "test:stack:up": "npm run dc -- -p pe-test --profile test up -d --build --wait",
    "test:stack:down": "npm run dc -- -p pe-test --profile test down -v --remove-orphans",
    "db:migrate": "npm run dc -- run --rm --build migrate",
    "db:migrate:status": "npm run dc -- run --rm migrate npx --no-install prisma migrate status",
    "db:migrate:create": "npm run dc -- --profile tools run --rm --build db-authoring npx --no-install prisma migrate dev --create-only --name",
    "db:seed": "npm run dc -- --profile dev run --rm --build seed",
    "db:psql": "npm run dc -- --profile tools run --rm psql",
    "secrets:scan": "npm run dc -- --profile tools run --rm secrets-scan",
    "build": "npm run prisma:generate --workspace backend && npm run build --workspace backend && npm run build --workspace frontend",
    "verify:adrs": "npm run verify:format && npm run verify:types && npm run verify:lint && npm run verify:deps && npm run verify:arch",
    "verify:format": "prettier --check .",
    "verify:types": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "verify:lint": "eslint . --max-warnings 0 --no-inline-config",
    "verify:deps": "depcruise backend/src frontend/src --config .dependency-cruiser.cjs",
    "verify:arch": "vitest run --config backend/vitest.config.ts --project unit --project architecture",
    "verify:coverage": "vitest run --config backend/vitest.config.ts --project unit --project architecture --coverage",
    "verify:env": "vitest run --config backend/vitest.config.ts backend/src/tests/unit/config/env.matrix.spec.ts --allowOnly=false --passWithNoTests=false --retry=0",
    "typecheck": "npm run verify:types",
    "lint": "npm run verify:lint",
    "lint:arch": "npm run verify:deps",
    "format": "prettier --write .",
    "test:unit": "vitest run --config backend/vitest.config.ts backend/src/tests/unit --allowOnly=false --passWithNoTests=false --retry=0",
    "test:int": "vitest run --config backend/vitest.config.ts backend/src/tests/integration --allowOnly=false --passWithNoTests=false --retry=0",
    "test:api": "vitest run --config backend/vitest.config.ts backend/src/tests/contract --allowOnly=false --passWithNoTests=false --retry=0",
    "test:mt": "vitest run --config backend/vitest.config.ts backend/src/tests/multi-tenant --allowOnly=false --passWithNoTests=false --retry=0",
    "test:conc": "vitest run --config backend/vitest.config.ts backend/src/tests/concurrency --allowOnly=false --passWithNoTests=false --retry=0",
    "test:sec": "vitest run --config backend/vitest.config.ts backend/src/tests/security --allowOnly=false --passWithNoTests=false --retry=0",
    "test:arch": "vitest run --config backend/vitest.config.ts backend/src/tests/architecture --allowOnly=false --passWithNoTests=false --retry=0",
    "test:infra": "vitest run --config backend/vitest.config.ts backend/src/tests/infra --allowOnly=false --passWithNoTests=false --retry=0",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test backend/src/tests/e2e/srs-section-8 --project=chromium",
    "test:load": "k6 run backend/src/tests/load/smoke.js && k6 run backend/src/tests/load/baseline.js",
    "test:load:full": "k6 run backend/src/tests/load/baseline.js && k6 run backend/src/tests/load/spike.js && k6 run backend/src/tests/load/stress.js && k6 run backend/src/tests/load/soak.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.5",
    "globals": "^17.14.0",
    "msw": "^2.15.0",
    "openapi-response-validator": "^12.1.3",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    },
    "effect": "^3.22.5"
  }
}
