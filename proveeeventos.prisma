  requesterUser       User                 @relation("fk_data_subject_requests__users", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_data_subject_requests__users")
  retentionExecutions RetentionExecution[] @relation("fk_retention_executions__data_subject_requests")

  @@index([requesterUserId, createdAt(sort: Desc)], map: "ix_data_subject_requests__requester_user_id_created_at")
  @@index([status, dueDate], map: "ix_data_subject_requests__status_due_date")
  @@map("data_subject_requests")
