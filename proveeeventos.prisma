  suggestedProviderId String?  @map("suggested_provider_id") @db.Uuid
  /// Referencia lógica a service_packages.id (ADR-DATA-03): `event-management` no depende de `provider-catalog`
  suggestedPackageId  String?  @map("suggested_package_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

