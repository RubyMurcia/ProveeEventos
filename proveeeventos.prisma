// ===== Módulo 09: assisted-response (TDD §4.2.9) =====

/// TDD §4.2.9 y §4.3.9. Fuente: DDD §4.10; SRS-WA-006..008; DEC-003
/// Respuesta externa importada y confirmada por una persona. Se crea al confirmar (S-07); el texto importado se minimiza a los 90 días.
// SQL-300 CHECK: ck_assisted_response_drafts__purga
// SQL-301 CHECK: ck_assisted_response_drafts__formato
// SQL-543 RLS (migración 20, TDD §5.2)
model AssistedResponseDraft {
  id               String    @id(map: "pk_assisted_response_drafts") @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  requestId        String    @map("request_id") @db.Uuid
  offerId          String    @map("offer_id") @db.Uuid
  schemaVersion    String    @map("schema_version")
  importedResponse Json?     @map("imported_response")
  validationResult Json      @map("validation_result")
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  importedByUserId String    @map("imported_by_user_id") @db.Uuid
  importedAt       DateTime  @map("imported_at") @db.Timestamptz(6)
  confirmedAt      DateTime  @map("confirmed_at") @db.Timestamptz(6)
  purgedAt         DateTime? @map("purged_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request RfqRequest @relation("fk_assisted_response_drafts__rfq_requests", fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assisted_response_drafts__rfq_requests")
  offer   RfqOffer   @relation("fk_assisted_response_drafts__rfq_offers", fields: [organizationId, offerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assisted_response_drafts__rfq_offers")

  @@unique([organizationId, offerId], map: "uq_assisted_response_drafts__organization_id_offer_id")
  @@index([organizationId, requestId], map: "ix_assisted_response_drafts__organization_id_request_id")
  @@index([confirmedAt], where: raw("purged_at IS NULL"), map: "ix_assisted_response_drafts__purge")
  @@map("assisted_response_drafts")
}

// ===== Módulo 10: reviews (TDD §4.2.10) =====

/// TDD §4.2.10 y §4.3.10. Fuente: DDD §5.10; SRS-REV-001..008; DEC-030
/// Reseña única de una contratación completada. La puntuación y el texto no se editan; cambian la respuesta y la visibilidad.
// SQL-310 CHECK: ck_reviews__puntajes
// SQL-311 CHECK: ck_reviews__promedio
// SQL-312 CHECK: ck_reviews__ocultacion
// SQL-433 trigger: trg_reviews__inmutable
// SQL-544 RLS (migración 20, TDD §5.2)
model Review {
  id                      String       @id(map: "pk_reviews") @default(uuid(7)) @db.Uuid
  organizationId          String       @map("organization_id") @db.Uuid
  bookingId               String       @map("booking_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): `reviews` no depende de `provider-catalog`
  providerId              String       @map("provider_id") @db.Uuid
  /// Referencia lógica a events.id (ADR-DATA-03): No depende de `event-management`
  eventId                 String       @map("event_id") @db.Uuid
  organizationDisplayName String       @map("organization_display_name") @db.VarChar(200)
  punctuality             Int          @db.SmallInt
  serviceQuality          Int          @map("service_quality") @db.SmallInt
  communication           Int          @db.SmallInt
  valueForMoney           Int          @map("value_for_money") @db.SmallInt
  average                 Decimal      @db.Decimal(3, 2)
  comment                 String?      @db.VarChar(500)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  authorUserId            String       @map("author_user_id") @db.Uuid
  status                  ReviewStatus @default(VISIBLE)
  hiddenAt                DateTime?    @map("hidden_at") @db.Timestamptz(6)
  providerResponse        String?      @map("provider_response") @db.VarChar(300)
  respondedAt             DateTime?    @map("responded_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  respondedByUserId       String?      @map("responded_by_user_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking       Booking        @relation("fk_reviews__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reviews__bookings")
  reviewReports ReviewReport[] @relation("fk_review_reports__reviews")

  @@unique([organizationId, id], map: "uq_reviews__organization_id_id")
  @@unique([organizationId, bookingId], map: "uq_reviews__organization_id_booking_id")
  @@index([providerId, status, createdAt(sort: Desc), id], map: "ix_reviews__provider_id_status_created_at_id")
  @@index([organizationId, createdAt(sort: Desc)], map: "ix_reviews__organization_id_created_at")
  @@map("reviews")
}

/// TDD §4.2.10 y §4.3.10. Fuente: SRS-REV-007; SRS-REV-008; OpenAPI ReviewReport
/// Reporte de una reseña y su resolución.
// SQL-313 CHECK: ck_review_reports__resolucion
// SQL-545 RLS (migración 20, TDD §5.2)
model ReviewReport {
  id               String              @id(map: "pk_review_reports") @default(uuid(7)) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  reviewId         String              @map("review_id") @db.Uuid
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  reporterUserId   String              @map("reporter_user_id") @db.Uuid
  reason           ReviewReportReason
  details          String?             @db.VarChar(1000)
  status           ReviewReportStatus  @default(PENDIENTE)
  decision         ModerationDecision?
  resolutionReason String?             @map("resolution_reason") @db.VarChar(1000)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  review Review @relation("fk_review_reports__reviews", fields: [organizationId, reviewId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_review_reports__reviews")

  @@unique([reviewId, reporterUserId], map: "uq_review_reports__review_id_reporter_user_id")
  @@index([organizationId, reviewId], map: "ix_review_reports__organization_id_review_id")
  @@index([status, createdAt], map: "ix_review_reports__status_created_at")
  @@map("review_reports")
}

// ===== Módulo 11: messaging-notifications (TDD §4.2.11) =====

/// TDD §4.2.11 y §4.3.11. Fuente: DDD §4.11; SAD §9.2; SRS-NOT-003
/// Plantilla versionada de email o aviso in-app.
// SQL-330 CHECK: ck_message_templates__asunto
model MessageTemplate {
  id              String               @id(map: "pk_message_templates") @default(uuid(7)) @db.Uuid
  code            String               @db.VarChar(80)
  templateVersion Int                  @map("template_version")
  channel         NotificationChannel
  category        NotificationCategory
  locale          String               @default("es-CO") @db.VarChar(10)
  subject         String?
  body            String
  mandatory       Boolean              @default(false)
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  notifications Notification[] @relation("fk_notifications__message_templates")

  @@unique([code, channel, templateVersion], map: "uq_message_templates__code_channel_template_version")
  @@unique([code, channel], where: raw("active = true"), map: "uq_message_templates__active")
  @@map("message_templates")
}

/// TDD §4.2.11 y §4.3.11. Fuente: DDD §5.11; SRS-NOT-001; SRS-NOT-002
/// Un aviso por canal y destinatario. Nunca contiene tokens: el enlace se inserta al enviar.
// SQL-331 CHECK: ck_notifications__destinatario
// SQL-546 RLS (migración 20, TDD §5.2)
model Notification {
  id                 String               @id(map: "pk_notifications") @default(uuid(7)) @db.Uuid
  organizationId     String?              @map("organization_id") @db.Uuid
  userId             String?              @map("user_id") @db.Uuid
  recipientEmail     String?              @map("recipient_email") @db.Citext
  channel            NotificationChannel
  category           NotificationCategory
  type               String               @db.VarChar(80)
  templateId         String?              @map("template_id") @db.Uuid
  title              String
  body               String
  actionResourceType String?              @map("action_resource_type")
  /// Referencia lógica a bookings.id (ADR-DATA-03): Polimórfica según `action_resource_type`
  actionResourceId   String?              @map("action_resource_id") @db.Uuid
  readAt             DateTime?            @map("read_at") @db.Timestamptz(6)
  dispatchStatus     DispatchStatus       @default(PENDIENTE) @map("dispatch_status")
  /// Referencia lógica a outbox_events.id (ADR-DATA-03): El outbox se purga
  sourceEventId      String?              @map("source_event_id") @db.Uuid
  dedupeKey          String               @map("dedupe_key") @db.VarChar(200)
  anonymizedAt       DateTime?            @map("anonymized_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization?     @relation("fk_notifications__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__organizations")
  user             User?             @relation("fk_notifications__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__users")
  template         MessageTemplate?  @relation("fk_notifications__message_templates", fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications__message_templates")
  deliveryAttempts DeliveryAttempt[] @relation("fk_delivery_attempts__notifications")

  @@unique([dedupeKey], map: "uq_notifications__dedupe_key")
  @@index([userId, createdAt(sort: Desc), id], map: "ix_notifications__user_id_created_at_id")
  @@index([userId, createdAt(sort: Desc)], where: raw("read_at IS NULL AND channel = 'IN_APP'"), map: "ix_notifications__unread")
  @@index([createdAt], where: raw("channel = 'EMAIL' AND dispatch_status = 'PENDIENTE'"), map: "ix_notifications__pending_email")
  @@index([organizationId, createdAt], map: "ix_notifications__organization_id_created_at")
  @@map("notifications")
}

/// TDD §4.2.11 y §4.3.11. Fuente: SRS-NOT-003; OpenAPI NotificationPreferences
/// Preferencia por categoría; las obligatorias se imponen en la aplicación.
model NotificationPreference {
  userId       String               @map("user_id") @db.Uuid
  category     NotificationCategory
  emailEnabled Boolean              @default(true) @map("email_enabled")
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("fk_notification_preferences__users", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_notification_preferences__users")

  @@id([userId, category], map: "pk_notification_preferences")
  @@map("notification_preferences")
}

/// TDD §4.2.11 y §4.3.11. Fuente: DDD §5.11; SRS-NOT-005; SRS-NOT-006
/// Intento de transporte de un email y su estado final.
// SQL-332 CHECK: ck_delivery_attempts__intento
model DeliveryAttempt {
  id                String         @id(map: "pk_delivery_attempts") @default(uuid(7)) @db.Uuid
  notificationId    String         @map("notification_id") @db.Uuid
  attemptNumber     Int            @map("attempt_number") @db.SmallInt
  status            DispatchStatus
  providerMessageId String?        @map("provider_message_id")
  errorCode         String?        @map("error_code")
  attemptedAt       DateTime       @map("attempted_at") @db.Timestamptz(6)
  statusUpdatedAt   DateTime?      @map("status_updated_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation("fk_delivery_attempts__notifications", fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_delivery_attempts__notifications")

  @@unique([notificationId, attemptNumber], map: "uq_delivery_attempts__notification_id_attempt_number")
  @@index([providerMessageId], map: "ix_delivery_attempts__provider_message_id")
  @@map("delivery_attempts")
}

/// TDD §4.2.11 y §4.3.11. Fuente: SRS-NOT-006; TEC-011
/// Eventos del webhook ya recibidos; evita reprocesarlos.
model EmailWebhookEvent {
  sgEventId         String    @id(map: "pk_email_webhook_events") @map("sg_event_id")
  eventType         String    @map("event_type")
  providerMessageId String?   @map("provider_message_id")
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(6)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([occurredAt], map: "ix_email_webhook_events__occurred_at")
  @@map("email_webhook_events")
}

// ===== Módulo 12: administration-audit (TDD §4.2.12) =====

/// TDD §4.2.12 y §4.3.12. Fuente: SRS §4.5; SAD §11.5; SRS-ADM-011; OpenAPI AuditLog
/// Bitácora inmutable de acciones sensibles y transaccionales (§5.3).
// SQL-360 CHECK: ck_audit_logs__cambios
// SQL-434 trigger: trg_audit_logs__inmutable
// SQL-547 RLS (migración 20, TDD §5.2)
model AuditLog {
  id             String      @id(map: "pk_audit_logs") @default(uuid(7)) @db.Uuid
  occurredAt     DateTime    @map("occurred_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  actorRole      String      @map("actor_role")
  /// Referencia lógica a organizations.id (ADR-DATA-03): La bitácora no depende de la vida del recurso
  organizationId String?     @map("organization_id") @db.Uuid
  action         String
  resourceType   String      @map("resource_type")
  /// Referencia lógica a bookings.id (ADR-DATA-03): Polimórfica según `resource_type`
  resourceId     String      @map("resource_id")
  result         AuditResult
  reason         String?
  correlationId  String      @map("correlation_id")
  changes        Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc), id], map: "ix_audit_logs__occurred_at_id")
  @@index([actorUserId, occurredAt(sort: Desc), id], map: "ix_audit_logs__actor_user_id_occurred_at_id")
  @@index([organizationId, occurredAt(sort: Desc), id], map: "ix_audit_logs__organization_id_occurred_at_id")
  @@index([resourceType, occurredAt(sort: Desc), id], map: "ix_audit_logs__resource_type_occurred_at_id")
  @@index([resourceType, resourceId], map: "ix_audit_logs__resource_type_resource_id")
  @@map("audit_logs")
}

/// TDD §4.2.12 y §4.3.12. Fuente: SRS-ADM-010; OpenAPI DisputeResolution; DDD §4.13
/// Resolución administrativa de una contratación en revisión o en incidencia.
