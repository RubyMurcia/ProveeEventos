/// TDD §4.2.8 y §4.3.8. Fuente: DDD §5.6; SRS-QUO-006..012; SRS §9.6
/// Cotización integral de un evento.
// SQL-250 CHECK: ck_quotations__importes
// SQL-251 CHECK: ck_quotations__version_snapshot
// SQL-534 RLS (migración 20, TDD §5.2)
model Quotation {
  id               String          @id(map: "pk_quotations") @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  eventId          String          @map("event_id") @db.Uuid
  templateId       String?         @map("template_id") @db.Uuid
  status           QuotationStatus @default(BORRADOR)
  snapshotVersion  Int             @default(0) @map("snapshot_version")
  subtotal         Decimal         @default("0") @db.Decimal(14, 2)
  commissionRate   Decimal?        @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal?        @map("commission_amount") @db.Decimal(14, 2)
  totalEstimated   Decimal         @default("0") @map("total_estimated") @db.Decimal(14, 2)
  currency         String          @default("COP") @db.Char(3)
  lastActivityAt   DateTime        @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(6)
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event              Event               @relation("fk_quotations__events", fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotations__events")
  template           EventTemplate?      @relation("fk_quotations__event_templates", fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_quotations__event_templates")
  quotationItems     QuotationItem[]     @relation("fk_quotation_items__quotations")
  quotationVersions  QuotationVersion[]  @relation("fk_quotation_versions__quotations")
  quotationDocuments QuotationDocument[] @relation("fk_quotation_documents__quotations")

  @@unique([organizationId, id], map: "uq_quotations__organization_id_id")
  @@index([organizationId, eventId, createdAt], map: "ix_quotations__organization_id_event_id_created_at")
  @@index([organizationId, status, createdAt], map: "ix_quotations__organization_id_status_created_at")
  @@map("quotations")
}

