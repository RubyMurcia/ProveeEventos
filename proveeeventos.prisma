// ProveeEventos — esquema Prisma (Prisma ORM 7.10.1)
// Fuente de verdad: ProveeEventos_TDD.md §4 (mapeo en §4.4). Archivo ensamblado desde Plans/Plan0005_work/prisma/: no editar a mano.
// Los objetos que Prisma no administra (CHECK, exclusiones, triggers, privilegios, RLS y extensiones) están en proveeeventos.sql;
// cada modelo afectado cita sus bloques SQL-nnn.
// Las URL de conexión NO van aquí (Prisma 7): prisma.config.ts usa DIRECT_URL para la CLI y el driver adapter usa DATABASE_URL.

/// TDD §4.4. partialIndexes es la única función preliminar (R-11).
generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["partialIndexes"]
}

/// TDD §4.4. Las extensiones se crean con SQL-001..SQL-004 antes del SQL base.
datasource db {
  provider = "postgresql"
}

