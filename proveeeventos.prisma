/// TDD §4.2.12 y §4.3.12. Fuente: SRS-ADM-012; DEC-003; H-17
/// Retención legal activa o liberada sobre un recurso.
// SQL-362 CHECK: ck_legal_holds__liberacion
// SQL-436 trigger: trg_legal_holds__sin_borrado
model LegalHold {
  id               String                @id(map: "pk_legal_holds") @default(uuid(7)) @db.Uuid
  resourceType     LegalHoldResourceType @map("resource_type")
  /// Referencia lógica a bookings.id (ADR-DATA-03): Polimórfica según `resource_type`
  resourceId       String                @map("resource_id") @db.Uuid
  reason           String                @db.VarChar(1000)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  setByUserId      String                @map("set_by_user_id") @db.Uuid
  setAt            DateTime              @map("set_at") @db.Timestamptz(6)
  releasedAt       DateTime?             @map("released_at") @db.Timestamptz(6)
  releasedByUserId String?               @map("released_by_user_id") @db.Uuid
  releaseReason    String?               @map("release_reason") @db.VarChar(1000)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resourceType, resourceId], where: raw("released_at IS NULL"), map: "uq_legal_holds__active")
  @@map("legal_holds")
}

/// TDD §4.2.12 y §4.3.12. Fuente: DEC-037; SRS-ADM-012
/// Festivos de Colombia para el cálculo de días hábiles.
model Holiday {
  holidayDate DateTime @id(map: "pk_holidays") @map("holiday_date") @db.Date
  name        String
  countryCode String   @default("CO") @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("holidays")
}

/// TDD §4.2.12 y §4.3.12. Fuente: DEC-003; SRS-EVT-007
/// Registro de cada archivado, anonimización o eliminación.
// SQL-363 CHECK: ck_retention_executions__filas
// SQL-437 trigger: trg_retention_executions__inmutable
model RetentionExecution {
  id                   String          @id(map: "pk_retention_executions") @default(uuid(7)) @db.Uuid
  jobName              String          @map("job_name")
  action               RetentionAction
  resourceType         String          @map("resource_type")
  /// Referencia lógica a users.id (ADR-DATA-03): Polimórfica según `resource_type`
  resourceId           String?         @map("resource_id") @db.Uuid
  affectedRows         Int             @map("affected_rows")
  dataSubjectRequestId String?         @map("data_subject_request_id") @db.Uuid
  result               AuditResult
  detail               String?
  executedAt           DateTime        @map("executed_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  dataSubjectRequest DataSubjectRequest? @relation("fk_retention_executions__data_subject_requests", fields: [dataSubjectRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_retention_executions__data_subject_requests")

  @@index([executedAt(sort: Desc)], map: "ix_retention_executions__executed_at")
  @@index([dataSubjectRequestId], map: "ix_retention_executions__data_subject_request_id")
  @@map("retention_executions")
}

// ===== Módulo 13: platform (TDD §4.2.13) =====

/// TDD §4.2.13 y §4.3.13. Fuente: SAD §7.4; ADR-008; DDD §8.2
/// Transactional Outbox: efectos pendientes escritos en la transacción de negocio (§5.3).
// SQL-390 CHECK: ck_outbox_events__payload
// SQL-391 CHECK: ck_outbox_events__intentos
model OutboxEvent {
  id             String       @id(map: "pk_outbox_events") @default(uuid(7)) @db.Uuid
  position       BigInt       @default(autoincrement())
  /// Referencia lógica a organizations.id (ADR-DATA-03): Tabla de sistema sin dependencias
  organizationId String?      @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  eventVersion   Int          @default(1) @map("event_version") @db.SmallInt
  aggregateType  String       @map("aggregate_type") @db.VarChar(60)
  /// Referencia lógica a bookings.id (ADR-DATA-03): Polimórfica según `aggregate_type`
  aggregateId    String       @map("aggregate_id") @db.Uuid
  payload        Json
  correlationId  String       @map("correlation_id") @db.VarChar(100)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(6)
  status         OutboxStatus @default(PENDIENTE)
  attempts       Int          @default(0) @db.SmallInt
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error") @db.VarChar(2000)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([position], map: "uq_outbox_events__position")
  @@index([availableAt, position], where: raw("status = 'PENDIENTE'"), map: "ix_outbox_events__pending")
  @@index([occurredAt], where: raw("status <> 'PUBLICADO'"), map: "ix_outbox_events__stuck")
  @@index([publishedAt], where: raw("status = 'PUBLICADO'"), map: "ix_outbox_events__purge")
  @@index([aggregateType, aggregateId, position], map: "ix_outbox_events__aggregate_type_aggregate_id_position")
  @@map("outbox_events")
}

/// TDD §4.2.13 y §4.3.13. Fuente: SAD §7.4; DDD §8.2
/// Eventos ya procesados por cada consumidor.
model ProcessedEvent {
  consumer    String   @db.VarChar(100)
  /// Referencia lógica a outbox_events.id (ADR-DATA-03): El outbox se purga antes o después
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumer, eventId], map: "pk_processed_events")
  @@index([processedAt], map: "ix_processed_events__processed_at")
  @@map("processed_events")
}

/// TDD §4.2.13 y §4.3.13. Fuente: TEC-003; SAD §10.6
/// Resultado guardado de un comando idempotente durante 24 horas.
// SQL-392 CHECK: ck_idempotency_keys__principal
// SQL-393 CHECK: ck_idempotency_keys__respuesta
model IdempotencyKey {
  id             String            @id(map: "pk_idempotency_keys") @default(uuid(7)) @db.Uuid
  /// Referencia lógica a organizations.id (ADR-DATA-03): Tabla de sistema sin dependencias
  organizationId String?           @map("organization_id") @db.Uuid
  principalType  String            @map("principal_type") @db.VarChar(20)
  principalId    String            @map("principal_id")
  operation      String            @db.VarChar(80)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(128)
  requestHash    Bytes             @map("request_hash")
  status         IdempotencyStatus @default(EN_PROCESO)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  resourceId     String?           @map("resource_id") @db.Uuid
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, principalType, principalId, operation, idempotencyKey], where: raw("organization_id IS NOT NULL"), map: "uq_idempotency_keys__tenant")
  @@unique([principalType, principalId, operation, idempotencyKey], where: raw("organization_id IS NULL"), map: "uq_idempotency_keys__global")
  @@index([expiresAt], map: "ix_idempotency_keys__expires_at")
  @@map("idempotency_keys")
}
