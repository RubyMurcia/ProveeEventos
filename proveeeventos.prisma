  category Category @relation("fk_event_categories__categories", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_categories__categories")
  subtype  Subtype? @relation("fk_event_categories__subtypes", fields: [categoryId, subtypeId], references: [categoryId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_categories__subtypes")

  @@unique([eventId, categoryId], where: raw("subtype_id IS NULL"), map: "uq_event_categories__category")
  @@unique([eventId, categoryId, subtypeId], where: raw("subtype_id IS NOT NULL"), map: "uq_event_categories__subtype")
  @@index([organizationId, eventId], map: "ix_event_categories__organization_id_event_id")
  @@map("event_categories")
}

