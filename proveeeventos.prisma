  bookingId                 String           @map("booking_id") @db.Uuid
  decision                  DisputeDecision
  resultingBookingStatus    BookingStatus    @map("resulting_booking_status")
  resultingCommissionStatus CommissionStatus @map("resulting_commission_status")
