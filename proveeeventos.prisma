  organizationPlans OrganizationPlan[] @relation("fk_organization_plans__plans")

  @@unique([code, revision], map: "uq_plans__code_revision")
  @@index([code, validFrom], map: "ix_plans__code_valid_from")
  @@map("plans")
}

/// TDD §4.2.2 y §4.3.2. Fuente: SRS-ADM-009; OpenAPI PlanAssignment
/// Plan asignado a una empresa en un periodo; los periodos no se solapan.
// SQL-037 CHECK: ck_organization_plans__periodo
// SQL-038 exclusión: ex_organization_plans__sin_solape
// SQL-514 RLS (migración 20, TDD §5.2)
model OrganizationPlan {
  id               String    @id(map: "pk_organization_plans") @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  validFrom        DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil       DateTime? @map("valid_until") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("fk_organization_plans__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organization_plans__organizations")
  plan         Plan         @relation("fk_organization_plans__plans", fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organization_plans__plans")

  @@index([organizationId, validFrom(sort: Desc)], map: "ix_organization_plans__organization_id_valid_from")
  @@map("organization_plans")
}

/// TDD §4.2.2 y §4.3.2. Fuente: SRS-TEN-003; SAD §4.4; H-22
/// Consumo acumulado por recurso limitado. La fila se bloquea al incrementar, lo que serializa los límites sin leer tablas de otros módulos (ADR-DATA-07).
// SQL-039 CHECK: ck_plan_usage_counters__consumo
// SQL-515 RLS (migración 20, TDD §5.2)
model PlanUsageCounter {
  organizationId String            @map("organization_id") @db.Uuid
  resource       PlanLimitResource
  periodStart    DateTime          @map("period_start") @db.Date
  used           Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("fk_plan_usage_counters__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_plan_usage_counters__organizations")

  @@id([organizationId, resource, periodStart], map: "pk_plan_usage_counters")
  @@map("plan_usage_counters")
}

// ===== Módulo 03: taxonomy-templates (TDD §4.2.3) =====

/// TDD §4.2.3 y §4.3.3. Fuente: SRS-CAT-003; DEC-020; PRD Anexo B
/// Categorías principales de la taxonomía global.
model Category {
  id        String   @id(map: "pk_categories") @default(uuid(7)) @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(120)
  active    Boolean  @default(true)
  sortOrder Int?     @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subtypes                Subtype[]                @relation("fk_subtypes__categories")
  eventTemplateSelections EventTemplateSelection[] @relation("fk_event_template_selections__categories")
  whatsappTemplates       WhatsappTemplate[]       @relation("fk_whatsapp_templates__categories")
  providerCategories      ProviderCategory[]       @relation("fk_provider_categories__categories")
  servicePackages         ServicePackage[]         @relation("fk_service_packages__categories")
  eventCategories         EventCategory[]          @relation("fk_event_categories__categories")
  quotationItems          QuotationItem[]          @relation("fk_quotation_items__categories")
  quickQuotations         QuickQuotation[]         @relation("fk_quick_quotations__categories")

  @@unique([code], map: "uq_categories__code")
  @@map("categories")
}

/// TDD §4.2.3 y §4.3.3. Fuente: SRS-CAT-004; DEC-020; H-12
/// Especialización de una categoría.
model Subtype {
  id          String   @id(map: "pk_subtypes") @default(uuid(7)) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(120)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category                Category                 @relation("fk_subtypes__categories", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_subtypes__categories")
  eventTemplateSelections EventTemplateSelection[] @relation("fk_event_template_selections__subtypes")
  providerSubtypes        ProviderSubtype[]        @relation("fk_provider_subtypes__subtypes")
  servicePackages         ServicePackage[]         @relation("fk_service_packages__subtypes")
  eventCategories         EventCategory[]          @relation("fk_event_categories__subtypes")
  quotationItems          QuotationItem[]          @relation("fk_quotation_items__subtypes")
  quotationItemSubtypes   QuotationItemSubtype[]   @relation("fk_quotation_item_subtypes__subtypes")
  quickQuotations         QuickQuotation[]         @relation("fk_quick_quotations__subtypes")

  @@unique([code], map: "uq_subtypes__code")
  @@unique([categoryId, id], map: "uq_subtypes__category_id_id")
  @@map("subtypes")
}

/// TDD §4.2.3 y §4.3.3. Fuente: SRS-EVT-002; SRS-EVT-004; DDD §4.5
/// Plantilla de evento global o privada de una empresa.
// SQL-060 CHECK: ck_event_templates__alcance
// SQL-516 RLS (migración 20, TDD §5.2)
model EventTemplate {
  id                       String        @id(map: "pk_event_templates") @default(uuid(7)) @db.Uuid
  scope                    TemplateScope
  organizationId           String?       @map("organization_id") @db.Uuid
  name                     String        @db.VarChar(160)
  active                   Boolean       @default(true)
  version                  Int           @default(1)
  duplicatedFromTemplateId String?       @map("duplicated_from_template_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                                    Organization?            @relation("fk_event_templates__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_templates__organizations")
  duplicatedFromTemplate                          EventTemplate?           @relation("fk_event_templates__event_templates", fields: [duplicatedFromTemplateId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_event_templates__event_templates")
  eventTemplates                                  EventTemplate[]          @relation("fk_event_templates__event_templates")
  eventTemplateSelectionsAsTemplate               EventTemplateSelection[] @relation("fk_event_template_selections__event_templates__template_id")
  eventTemplateSelectionsAsTemplateByOrganization EventTemplateSelection[] @relation("fk_event_template_selections__event_templates__org_template_id")
  events                                          Event[]                  @relation("fk_events__event_templates")
  quotations                                      Quotation[]              @relation("fk_quotations__event_templates")

  @@unique([organizationId, id], map: "uq_event_templates__organization_id_id")
  @@index([organizationId, active, name], map: "ix_event_templates__organization_id_active_name")
  @@map("event_templates")
}

/// TDD §4.2.3 y §4.3.3. Fuente: DDD §4.5; OpenAPI EventTemplateInput
/// Categorías y subtipos recomendados por una plantilla; se reemplazan en bloque.
// SQL-517 RLS (migración 20, TDD §5.2)
model EventTemplateSelection {
  id             String   @id(map: "pk_event_template_selections") @default(uuid(7)) @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  subtypeId      String?  @map("subtype_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template               EventTemplate  @relation("fk_event_template_selections__event_templates__template_id", fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_event_template_selections__event_templates__template_id")
  templateByOrganization EventTemplate? @relation("fk_event_template_selections__event_templates__org_template_id", fields: [organizationId, templateId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "fk_event_template_selections__event_templates__org_template_id")
  category               Category       @relation("fk_event_template_selections__categories", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_template_selections__categories")
  subtype                Subtype?       @relation("fk_event_template_selections__subtypes", fields: [categoryId, subtypeId], references: [categoryId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_template_selections__subtypes")

  @@unique([templateId, categoryId], where: raw("subtype_id IS NULL"), map: "uq_event_template_selections__category")
  @@unique([templateId, categoryId, subtypeId], where: raw("subtype_id IS NOT NULL"), map: "uq_event_template_selections__subtype")
  @@index([templateId], map: "ix_event_template_selections__template_id")
  @@index([organizationId, templateId], map: "ix_event_template_selections__organization_id_template_id")
  @@map("event_template_selections")
}

/// TDD §4.2.3 y §4.3.3. Fuente: SRS-WA-001; SRS-ADM-004; PRD Anexo D
