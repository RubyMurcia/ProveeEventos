  userId               String             @map("user_id") @db.Uuid
  businessName         String             @map("business_name") @db.VarChar(200)
  providerType         ProviderType       @map("provider_type")
  taxId                String?            @map("tax_id") @db.VarChar(40)
  description          String?            @db.VarChar(5000)
  city                 String             @db.VarChar(120)
  phone                String             @db.VarChar(40)
  whatsapp             String?            @db.VarChar(40)
  contactEmail         String             @map("contact_email") @db.Citext
  preferredChannel     ContactChannel     @default(EMAIL_FORM) @map("preferred_channel")
  maxGuestCapacity     Int?               @map("max_guest_capacity")
  verificationStatus   VerificationStatus @default(PENDIENTE) @map("verification_status")
  verificationLevel    Int?               @map("verification_level") @db.SmallInt
  accountStatus        AccountStatus      @default(ACTIVO) @map("account_status")
  suspendedAt          DateTime?          @map("suspended_at") @db.Timestamptz(6)
