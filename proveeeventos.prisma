/// TDD §4.2.12 y §4.3.12. Fuente: SRS-ADM-012; SRS-NFR-PRIV-002; DEC-037
/// Solicitud de consulta, corrección o supresión de datos personales, con plazo en días hábiles.
// SQL-361 CHECK: ck_data_subject_requests__prorroga
model DataSubjectRequest {
