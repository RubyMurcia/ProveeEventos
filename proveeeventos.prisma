  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                            User                             @relation("fk_providers__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_providers__users")
  providerCategories              ProviderCategory[]               @relation("fk_provider_categories__providers")
  providerCoverageAreas           ProviderCoverageArea[]           @relation("fk_provider_coverage_areas__providers")
  portfolioAssets                 PortfolioAsset[]                 @relation("fk_portfolio_assets__providers")
  servicePackages                 ServicePackage[]                 @relation("fk_service_packages__providers")
  providerVerificationSubmissions ProviderVerificationSubmission[] @relation("fk_provider_verification_submissions__providers")
  providerVerificationDecisions   ProviderVerificationDecision[]   @relation("fk_provider_verification_decisions__providers")
  providerVerificationEvidences   ProviderVerificationEvidence[]   @relation("fk_provider_verification_evidence__providers")
  providerReputation              ProviderReputation?              @relation("fk_provider_reputation__providers")
  providerAvailability            ProviderAvailability?            @relation("fk_provider_availability__providers")
  providerDailyCapacities         ProviderDailyCapacity[]          @relation("fk_provider_daily_capacity__providers")
  bookings                        Booking[]                        @relation("fk_bookings__providers")
  rfqRequests                     RfqRequest[]                     @relation("fk_rfq_requests__providers")

  @@unique([userId], map: "uq_providers__user_id")
  @@index([verificationStatus, accountStatus, createdAt], map: "ix_providers__verification_status_account_status_created_at")
  @@map("providers")
}

/// TDD §4.2.4 y §4.3.4. Fuente: SRS-CAT-005
