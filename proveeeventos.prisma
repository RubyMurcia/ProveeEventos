  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cycle   RfqCycle   @relation("fk_awards__rfq_cycles", fields: [organizationId, cycleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_awards__rfq_cycles")
  request RfqRequest @relation("fk_awards__rfq_requests", fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_awards__rfq_requests")
  offer   RfqOffer   @relation("fk_awards__rfq_offers", fields: [organizationId, offerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_awards__rfq_offers")
  booking Booking    @relation("fk_awards__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_awards__bookings")

  @@unique([organizationId, cycleId], map: "uq_awards__organization_id_cycle_id")
  @@unique([organizationId, requestId], map: "uq_awards__organization_id_request_id")
  @@unique([organizationId, offerId], map: "uq_awards__organization_id_offer_id")
  @@unique([organizationId, bookingId], map: "uq_awards__organization_id_booking_id")
  @@index([organizationId, quotationItemId], map: "ix_awards__organization_id_quotation_item_id")
  @@map("awards")
