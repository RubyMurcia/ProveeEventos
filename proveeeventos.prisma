// SQL-158 CHECK: ck_bookings__consumo
// SQL-522 RLS (migración 20, TDD §5.2)
model Booking {
  id                        String                    @id(map: "pk_bookings") @default(uuid(7)) @db.Uuid
  organizationId            String                    @map("organization_id") @db.Uuid
  /// Referencia lógica a events.id (ADR-DATA-03): `availability-booking` no depende de `event-management` (SAD §4.4)
  eventId                   String                    @map("event_id") @db.Uuid
  /// Referencia lógica a quotation_items.id (ADR-DATA-03): No depende de `quotation`
  quotationItemId           String                    @map("quotation_item_id") @db.Uuid
  providerId                String                    @map("provider_id") @db.Uuid
  packageId                 String?                   @map("package_id") @db.Uuid
  origin                    BookingOrigin
  status                    BookingStatus             @default(CONFIRMADO)
  quantity                  Int                       @default(1)
  serviceStartsAt           DateTime                  @map("service_starts_at") @db.Timestamptz(6)
  serviceEndsAt             DateTime                  @map("service_ends_at") @db.Timestamptz(6)
  timeZone                  String                    @map("time_zone") @db.VarChar(64)
  firstServiceDate          DateTime                  @map("first_service_date") @db.Date
  acceptedPrice             Decimal                   @map("accepted_price") @db.Decimal(14, 2)
  currency                  String                    @default("COP") @db.Char(3)
  consumesGlobalCapacity    Boolean                   @map("consumes_global_capacity")
  consumesPackageCapacity   Boolean                   @map("consumes_package_capacity")
  confirmedAt               DateTime                  @map("confirmed_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  confirmedByUserId         String                    @map("confirmed_by_user_id") @db.Uuid
  reviewOrigin              ReviewOrigin?             @map("review_origin")
  organizerReviewDecision   SuspensionReviewDecision? @map("organizer_review_decision")
  organizerReviewDecidedAt  DateTime?                 @map("organizer_review_decided_at") @db.Timestamptz(6)
  reviewDecisionDueAt       DateTime?                 @map("review_decision_due_at") @db.Timestamptz(6)
  reviewWindowClosedAt      DateTime?                 @map("review_window_closed_at") @db.Timestamptz(6)
  cancellationRequestedBy   BookingParty?             @map("cancellation_requested_by")
  cancellationRequestedAt   DateTime?                 @map("cancellation_requested_at") @db.Timestamptz(6)
  cancellationResponseDueAt DateTime?                 @map("cancellation_response_due_at") @db.Timestamptz(6)
  cancellationReason        String?                   @map("cancellation_reason") @db.VarChar(1000)
  serviceMarkedDoneAt       DateTime?                 @map("service_marked_done_at") @db.Timestamptz(6)
  completionDueAt           DateTime?                 @map("completion_due_at") @db.Timestamptz(6)
  closureReminderSentAt     DateTime?                 @map("closure_reminder_sent_at") @db.Timestamptz(6)
  completedAt               DateTime?                 @map("completed_at") @db.Timestamptz(6)
  cancelledAt               DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization            @relation("fk_bookings__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bookings__organizations")
  provider               Provider                @relation("fk_bookings__providers", fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bookings__providers")
  package                ServicePackage?         @relation("fk_bookings__service_packages", fields: [providerId, packageId], references: [providerId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bookings__service_packages")
  bookingConsumedDates   BookingConsumedDate[]   @relation("fk_booking_consumed_dates__bookings")
  bookingTermsSnapshot   BookingTermsSnapshot?   @relation("fk_booking_terms_snapshots__bookings")
  bookingStatusHistories BookingStatusHistory[]  @relation("fk_booking_status_history__bookings")
  bookingChangeProposals BookingChangeProposal[] @relation("fk_booking_change_proposals__bookings")
  commissionRecord       CommissionRecord?       @relation("fk_commission_records__bookings")
  award                  Award?                  @relation("fk_awards__bookings")
  review                 Review?                 @relation("fk_reviews__bookings")
  disputeResolutions     DisputeResolution[]     @relation("fk_dispute_resolutions__bookings")

  @@unique([organizationId, id], map: "uq_bookings__organization_id_id")
  @@unique([quotationItemId], where: raw("status <> ALL (ARRAY['CANCELADO'::booking_status, 'NO_PRESTADO'::booking_status])"), map: "uq_bookings__active_item")
  @@index([organizationId, createdAt(sort: Desc)], map: "ix_bookings__organization_id_created_at")
  @@index([organizationId, eventId, status], map: "ix_bookings__organization_id_event_id_status")
  @@index([organizationId, quotationItemId], map: "ix_bookings__organization_id_quotation_item_id")
  @@index([providerId, status, firstServiceDate], map: "ix_bookings__provider_id_status_first_service_date")
  @@index([providerId, packageId], map: "ix_bookings__provider_id_package_id")
  @@index([serviceStartsAt], where: raw("status = 'CONFIRMADO'"), map: "ix_bookings__start_job")
  @@index([cancellationResponseDueAt], where: raw("status = 'CANCELACION_SOLICITADA'"), map: "ix_bookings__cancel_timeout")
  @@index([completionDueAt], where: raw("status = 'SERVICIO_REALIZADO'"), map: "ix_bookings__auto_close")
  @@index([reviewDecisionDueAt], where: raw("status = 'CANCELACION_EN_REVISION' AND review_window_closed_at IS NULL"), map: "ix_bookings__review_window")
  @@index([status, createdAt], where: raw("status = ANY (ARRAY['CANCELACION_EN_REVISION'::booking_status, 'INCIDENCIA'::booking_status])"), map: "ix_bookings__disputes")
  @@map("bookings")
}

/// TDD §4.2.6 y §4.3.6. Fuente: SRS-EVT-010; DEC-025; ADR-016
/// Fechas locales que consume cada contratación; permite liberar y reconciliar los contadores.
// SQL-159 CHECK: ck_booking_consumed_dates__cantidad
// SQL-523 RLS (migración 20, TDD §5.2)
model BookingConsumedDate {
  bookingId      String    @map("booking_id") @db.Uuid
  localDate      DateTime  @map("local_date") @db.Date
  organizationId String    @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la contratación
  providerId     String    @map("provider_id") @db.Uuid
  /// Referencia lógica a service_packages.id (ADR-DATA-03): Copia de la contratación
  packageId      String?   @map("package_id") @db.Uuid
  quantity       Int
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation("fk_booking_consumed_dates__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_booking_consumed_dates__bookings")

  @@id([bookingId, localDate], map: "pk_booking_consumed_dates")
  @@index([organizationId, bookingId], map: "ix_booking_consumed_dates__organization_id_booking_id")
  @@index([providerId, localDate], where: raw("released_at IS NULL"), map: "ix_booking_consumed_dates__provider")
  @@index([packageId, localDate], where: raw("released_at IS NULL AND package_id IS NOT NULL"), map: "ix_booking_consumed_dates__package")
  @@map("booking_consumed_dates")
}

/// TDD §4.2.6 y §4.3.6. Fuente: ADR-019; DEC-018; SRS-BOOK-004
/// Términos aceptados, congelados al confirmar (§5.3).
// SQL-160 CHECK: ck_booking_terms_snapshots__formato
// SQL-425 trigger: trg_booking_terms_snapshots__inmutable
// SQL-524 RLS (migración 20, TDD §5.2)
model BookingTermsSnapshot {
  bookingId      String   @id(map: "pk_booking_terms_snapshots") @map("booking_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la contratación
  providerId     String   @map("provider_id") @db.Uuid
  schemaVersion  Int      @map("schema_version") @db.SmallInt
  terms          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation("fk_booking_terms_snapshots__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_booking_terms_snapshots__bookings")

  @@unique([organizationId, bookingId], map: "uq_booking_terms_snapshots__organization_id_booking_id")
  @@map("booking_terms_snapshots")
}

/// TDD §4.2.6 y §4.3.6. Fuente: SRS-BOOK-009; SRS-BOOK-007
/// Cada transición de la contratación, con actor y motivo.
// SQL-426 trigger: trg_booking_status_history__inmutable
// SQL-525 RLS (migración 20, TDD §5.2)
model BookingStatusHistory {
  id             String         @id(map: "pk_booking_status_history") @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la contratación
  providerId     String         @map("provider_id") @db.Uuid
  bookingId      String         @map("booking_id") @db.Uuid
  fromStatus     BookingStatus? @map("from_status")
  toStatus       BookingStatus  @map("to_status")
  actorParty     BookingParty   @map("actor_party")
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  reason         String?        @db.VarChar(2000)
  evidenceUrl    String?        @map("evidence_url")
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation("fk_booking_status_history__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_booking_status_history__bookings")

  @@index([organizationId, bookingId, occurredAt], map: "ix_booking_status_history__org_booking_id_occurred_at")
  @@map("booking_status_history")
}

/// TDD §4.2.6 y §4.3.6. Fuente: SRS-BOOK-005; SRS-EVT-008
/// Modificación de alcance o precio propuesta, que la contraparte debe aceptar (H-19; sin operación de API, Q-03).
// SQL-167 CHECK: ck_booking_change_proposals__importes
// SQL-526 RLS (migración 20, TDD §5.2)
model BookingChangeProposal {
  id                String               @id(map: "pk_booking_change_proposals") @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la contratación
  providerId        String               @map("provider_id") @db.Uuid
  bookingId         String               @map("booking_id") @db.Uuid
  proposedBy        BookingParty         @map("proposed_by")
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  proposedByUserId  String               @map("proposed_by_user_id") @db.Uuid
  description       String
  proposedPrice     Decimal?             @map("proposed_price") @db.Decimal(14, 2)
  currency          String               @default("COP") @db.Char(3)
  status            ChangeProposalStatus @default(PENDIENTE)
  respondedAt       DateTime?            @map("responded_at") @db.Timestamptz(6)
  respondedByUserId String?              @map("responded_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation("fk_booking_change_proposals__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_booking_change_proposals__bookings")

  @@unique([bookingId], where: raw("status = 'PENDIENTE'"), map: "uq_booking_change_proposals__pending")
  @@index([organizationId, bookingId], map: "ix_booking_change_proposals__organization_id_booking_id")
  @@map("booking_change_proposals")
}

/// TDD §4.2.6 y §4.3.6. Fuente: SAD §6.4; DEC-010; DEC-027
/// Porcentaje de comisión versionado, con periodos que no se solapan.
// SQL-161 CHECK: ck_commission_rates__porcentaje
// SQL-162 CHECK: ck_commission_rates__periodo
// SQL-163 exclusión: ex_commission_rates__sin_solape
model CommissionRate {
  id              String    @id(map: "pk_commission_rates") @default(uuid(7)) @db.Uuid
  rate            Decimal   @db.Decimal(5, 4)
  validFrom       DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("commission_rates")
}

/// TDD §4.2.6 y §4.3.6. Fuente: TEC-010; SRS-BOOK-010; DEC-033
/// Registro de comisión de una contratación; no implica cobro.
// SQL-164 CHECK: ck_commission_records__importes
// SQL-165 CHECK: ck_commission_records__devengo
// SQL-166 CHECK: ck_commission_records__reversion
// SQL-427 trigger: trg_commission_records__sin_borrado
// SQL-527 RLS (migración 20, TDD §5.2)
model CommissionRecord {
  id               String           @id(map: "pk_commission_records") @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la contratación
  providerId       String           @map("provider_id") @db.Uuid
  bookingId        String           @map("booking_id") @db.Uuid
  status           CommissionStatus @default(PENDIENTE)
  rate             Decimal          @db.Decimal(5, 4)
  baseAmount       Decimal          @map("base_amount") @db.Decimal(14, 2)
  amount           Decimal          @db.Decimal(14, 2)
  currency         String           @default("COP") @db.Char(3)
  accruedAt        DateTime?        @map("accrued_at") @db.Timestamptz(6)
  closedAt         DateTime?        @map("closed_at") @db.Timestamptz(6)
  reversedAt       DateTime?        @map("reversed_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  reversedByUserId String?          @map("reversed_by_user_id") @db.Uuid
  reversalReason   String?          @map("reversal_reason") @db.VarChar(1000)
  invoiceReference String?          @map("invoice_reference") @db.VarChar(100)
  paymentReference String?          @map("payment_reference") @db.VarChar(100)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation("fk_commission_records__bookings", fields: [organizationId, bookingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_commission_records__bookings")

  @@unique([organizationId, bookingId], map: "uq_commission_records__organization_id_booking_id")
  @@index([accruedAt], where: raw("status = 'DEVENGADA'"), map: "ix_commission_records__accrued")
  @@index([reversedAt], where: raw("status = 'REVERTIDA'"), map: "ix_commission_records__reversed")
  @@map("commission_records")
}

// ===== Módulo 07: rfq-offers (TDD §4.2.7) =====

/// TDD §4.2.7 y §4.3.7. Fuente: SAD §7.2; SAD §4.4; H-08
/// Fila propia de `rfq-offers` por ítem cotizado: punto de bloqueo de la adjudicación y de las rondas (ADR-DATA-04).
// SQL-528 RLS (migración 20, TDD §5.2)
model RfqItem {
  /// Referencia lógica a quotation_items.id (ADR-DATA-03): `rfq-offers` no depende de `quotation`
  quotationItemId String   @id(map: "pk_rfq_items") @map("quotation_item_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  /// Referencia lógica a events.id (ADR-DATA-03): No depende de `event-management`
  eventId         String   @map("event_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("fk_rfq_items__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_items__organizations")
  rfqCycles    RfqCycle[]   @relation("fk_rfq_cycles__rfq_items")

  @@unique([organizationId, quotationItemId], map: "uq_rfq_items__organization_id_quotation_item_id")
  @@index([organizationId, eventId], map: "ix_rfq_items__organization_id_event_id")
  @@map("rfq_items")
}

/// TDD §4.2.7 y §4.3.7. Fuente: TEC-002; DDD §4.9; SRS-RFQ-010
/// Ronda de solicitudes paralelas de un ítem, con SLA común.
// SQL-210 CHECK: ck_rfq_cycles__sla
// SQL-211 CHECK: ck_rfq_cycles__ronda
// SQL-529 RLS (migración 20, TDD §5.2)
model RfqCycle {
  id              String         @id(map: "pk_rfq_cycles") @default(uuid(7)) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  quotationItemId String         @map("quotation_item_id") @db.Uuid
  /// Referencia lógica a events.id (ADR-DATA-03): Copia del ítem
  eventId         String         @map("event_id") @db.Uuid
  round           Int            @db.SmallInt
  slaHours        Int            @map("sla_hours") @db.SmallInt
  channel         ContactChannel
  scope           String         @db.VarChar(6000)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotationItem RfqItem      @relation("fk_rfq_cycles__rfq_items", fields: [organizationId, quotationItemId], references: [organizationId, quotationItemId], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_cycles__rfq_items")
  rfqRequests   RfqRequest[] @relation("fk_rfq_requests__rfq_cycles")
  award         Award?       @relation("fk_awards__rfq_cycles")

  @@unique([quotationItemId, round], map: "uq_rfq_cycles__quotation_item_id_round")
  @@unique([organizationId, id], map: "uq_rfq_cycles__organization_id_id")
  @@index([organizationId, quotationItemId], map: "ix_rfq_cycles__organization_id_quotation_item_id")
  @@map("rfq_cycles")
}

/// TDD §4.2.7 y §4.3.7. Fuente: DDD §5.8; SRS-RFQ-002..005; SRS-RFQ-013
/// Solicitud individual a un proveedor, con su SLA y estado de envío.
// SQL-212 CHECK: ck_rfq_requests__cupo
// SQL-213 CHECK: ck_rfq_requests__reintentos
// SQL-214 CHECK: ck_rfq_requests__snapshot
// SQL-428 trigger: trg_rfq_requests__snapshot_inmutable
// SQL-530 RLS (migración 20, TDD §5.2)
model RfqRequest {
  id                    String         @id(map: "pk_rfq_requests") @default(uuid(7)) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  cycleId               String         @map("cycle_id") @db.Uuid
  /// Referencia lógica a quotation_items.id (ADR-DATA-03): Copia de la ronda
  quotationItemId       String         @map("quotation_item_id") @db.Uuid
  /// Referencia lógica a events.id (ADR-DATA-03): Copia de la ronda
  eventId               String         @map("event_id") @db.Uuid
  providerId            String         @map("provider_id") @db.Uuid
  slot                  Int            @db.SmallInt
  status                RfqStatus      @default(PENDIENTE_ENVIO)
  channel               ContactChannel
  dispatchStatus        DispatchStatus @default(PENDIENTE) @map("dispatch_status")
  snapshotSchemaVersion Int            @map("snapshot_schema_version") @db.SmallInt
  requestSnapshot       Json           @map("request_snapshot")
  slaExpiresAt          DateTime       @map("sla_expires_at") @db.Timestamptz(6)
  sentAt                DateTime?      @map("sent_at") @db.Timestamptz(6)
  slaReminderSentAt     DateTime?      @map("sla_reminder_sent_at") @db.Timestamptz(6)
  respondedAt           DateTime?      @map("responded_at") @db.Timestamptz(6)
  rejectedAt            DateTime?      @map("rejected_at") @db.Timestamptz(6)
  rejectionReason       String?        @map("rejection_reason") @db.VarChar(1000)
  expiredAt             DateTime?      @map("expired_at") @db.Timestamptz(6)
  cancelledAt           DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?        @map("cancel_reason") @db.VarChar(1000)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  cancelledByUserId     String?        @map("cancelled_by_user_id") @db.Uuid
  retryCount            Int            @default(0) @map("retry_count") @db.SmallInt
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cycle                  RfqCycle                @relation("fk_rfq_requests__rfq_cycles", fields: [organizationId, cycleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_requests__rfq_cycles")
  provider               Provider                @relation("fk_rfq_requests__providers", fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_requests__providers")
  magicLinkGrants        MagicLinkGrant[]        @relation("fk_magic_link_grants__rfq_requests")
  rfqOffers              RfqOffer[]              @relation("fk_rfq_offers__rfq_requests")
  award                  Award?                  @relation("fk_awards__rfq_requests")
  assistedResponseDrafts AssistedResponseDraft[] @relation("fk_assisted_response_drafts__rfq_requests")

  @@unique([cycleId, slot], map: "uq_rfq_requests__cycle_id_slot")
  @@unique([cycleId, providerId], map: "uq_rfq_requests__cycle_id_provider_id")
  @@unique([organizationId, id], map: "uq_rfq_requests__organization_id_id")
  @@index([organizationId, cycleId], map: "ix_rfq_requests__organization_id_cycle_id")
  @@index([organizationId, eventId, status], map: "ix_rfq_requests__organization_id_event_id_status")
  @@index([organizationId, quotationItemId, status], map: "ix_rfq_requests__organization_id_quotation_item_id_status")
  @@index([organizationId, createdAt(sort: Desc)], map: "ix_rfq_requests__organization_id_created_at")
  @@index([providerId, status, slaExpiresAt], map: "ix_rfq_requests__provider_id_status_sla_expires_at")
  @@index([slaExpiresAt], where: raw("status = ANY (ARRAY['PENDIENTE_ENVIO'::rfq_status, 'ENVIADO'::rfq_status, 'RESPONDIDO'::rfq_status, 'ERROR_ENVIO'::rfq_status])"), map: "ix_rfq_requests__sla")
  @@map("rfq_requests")
}

/// TDD §4.2.7 y §4.3.7. Fuente: SAD §7.3; TEC-008; SRS-MAGIC-001..004
/// Credencial de capacidad limitada de una solicitud. Solo guarda el hash y el material de derivación.
// SQL-215 CHECK: ck_magic_link_grants__token
// SQL-531 RLS (migración 20, TDD §5.2)
model MagicLinkGrant {
