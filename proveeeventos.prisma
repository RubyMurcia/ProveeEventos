/// TDD §4.2.7 y §4.3.7. Fuente: TEC-001; DEC-005; SRS-RFQ-006; SRS §9.7; H-10
/// Respuesta de un proveedor: revisión inmutable de oferta o rechazo. Solo cambian `status` y `status_changed_at`.
// SQL-216 CHECK: ck_rfq_offers__decision
// SQL-217 CHECK: ck_rfq_offers__precio
// SQL-218 CHECK: ck_rfq_offers__revision
// SQL-219 CHECK: ck_rfq_offers__extras
// SQL-429 trigger: trg_rfq_offers__inmutable
// SQL-532 RLS (migración 20, TDD §5.2)
model RfqOffer {
  id                   String            @id(map: "pk_rfq_offers") @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  /// Referencia lógica a providers.id (ADR-DATA-03): Copia de la solicitud
  providerId           String            @map("provider_id") @db.Uuid
  requestId            String            @map("request_id") @db.Uuid
  revision             Int
  decision             OfferDecision
  status               OfferStatus?
  availability         OfferAvailability
  totalPrice           Decimal?          @map("total_price") @db.Decimal(14, 2)
  currency             String            @default("COP") @db.Char(3)
  extras               Json              @default("[]")
  conditions           String?           @db.VarChar(4000)
  notes                String?           @db.VarChar(3000)
  validUntil           DateTime?         @map("valid_until") @db.Timestamptz(6)
  origin               OfferOrigin
  revisionReason       String?           @map("revision_reason") @db.VarChar(1000)
  supersedesOfferId    String?           @map("supersedes_offer_id") @db.Uuid
  replacementConfirmed Boolean           @default(false) @map("replacement_confirmed")
  receivedAt           DateTime          @map("received_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  submittedByUserId    String?           @map("submitted_by_user_id") @db.Uuid
  statusChangedAt      DateTime?         @map("status_changed_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request               RfqRequest             @relation("fk_rfq_offers__rfq_requests", fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_offers__rfq_requests")
  supersedesOffer       RfqOffer?              @relation("fk_rfq_offers__rfq_offers", fields: [supersedesOfferId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rfq_offers__rfq_offers")
  rfqOffers             RfqOffer[]             @relation("fk_rfq_offers__rfq_offers")
  award                 Award?                 @relation("fk_awards__rfq_offers")
  assistedResponseDraft AssistedResponseDraft? @relation("fk_assisted_response_drafts__rfq_offers")

  @@unique([requestId, revision], map: "uq_rfq_offers__request_id_revision")
  @@unique([requestId], where: raw("status = 'RECIBIDA'"), map: "uq_rfq_offers__current")
  @@unique([organizationId, id], map: "uq_rfq_offers__organization_id_id")
  @@index([organizationId, requestId], map: "ix_rfq_offers__organization_id_request_id")
  @@index([validUntil], where: raw("status = 'RECIBIDA'"), map: "ix_rfq_offers__validity")
  @@index([providerId, receivedAt(sort: Desc)], map: "ix_rfq_offers__provider_id_received_at")
  @@index([supersedesOfferId], map: "ix_rfq_offers__supersedes_offer_id")
  @@map("rfq_offers")
}

/// TDD §4.2.7 y §4.3.7. Fuente: DDD §5.9; SRS-RFQ-009; ADR-DATA-05
