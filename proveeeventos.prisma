  currency             String    @default("COP") @db.Char(3)
  maxActiveEvents      Int?      @map("max_active_events")
  maxMonthlyQuotations Int?      @map("max_monthly_quotations")
  maxCoordinators      Int?      @map("max_coordinators")
  maxCustomTemplates   Int?      @map("max_custom_templates")
  trialDays            Int?      @map("trial_days")
  validFrom            DateTime  @map("valid_from") @db.Date
  validUntil           DateTime? @map("valid_until") @db.Date
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
