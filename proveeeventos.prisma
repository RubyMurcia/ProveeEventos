  extendedDueDate     DateTime?         @map("extended_due_date") @db.Date
  extensionReason     String?           @map("extension_reason")
  extensionNotifiedAt DateTime?         @map("extension_notified_at") @db.Timestamptz(6)
  resolution          String?           @db.VarChar(2000)
  resolvedAt          DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
