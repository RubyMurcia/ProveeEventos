// ===== Módulo 05: event-management (TDD §4.2.5) =====

/// TDD §4.2.5 y §4.3.5. Fuente: DDD §5.5; SRS-EVT-001; DEC-007
/// Evento de una empresa, raíz del flujo de cotización.
// SQL-130 CHECK: ck_events__intervalo
// SQL-131 CHECK: ck_events__invitados
// SQL-132 CHECK: ck_events__presupuesto
// SQL-133 CHECK: ck_events__coordenadas
// SQL-519 RLS (migración 20, TDD §5.2)
model Event {
  id                      String      @id(map: "pk_events") @default(uuid(7)) @db.Uuid
  organizationId          String      @map("organization_id") @db.Uuid
  coordinatorMembershipId String?     @map("coordinator_membership_id") @db.Uuid
  templateId              String?     @map("template_id") @db.Uuid
  name                    String      @db.VarChar(160)
  localStartsAt           DateTime    @map("local_starts_at") @db.Timestamp(0)
  localEndsAt             DateTime    @map("local_ends_at") @db.Timestamp(0)
  timeZone                String      @map("time_zone") @db.VarChar(64)
  startsAtUtc             DateTime    @map("starts_at_utc") @db.Timestamptz(6)
  endsAtUtc               DateTime    @map("ends_at_utc") @db.Timestamptz(6)
  eventDate               DateTime    @map("event_date") @db.Date
  guests                  Int
  locationAddress         String?     @map("location_address") @db.VarChar(300)
  locationCity            String      @map("location_city") @db.VarChar(120)
  latitude                Decimal?    @db.Decimal(9, 6)
  longitude               Decimal?    @db.Decimal(9, 6)
  estimatedBudget         Decimal?    @map("estimated_budget") @db.Decimal(14, 2)
  currency                String      @default("COP") @db.Char(3)
  notes                   String?     @db.VarChar(5000)
  status                  EventStatus @default(BORRADOR)
  archivedAt              DateTime?   @map("archived_at") @db.Timestamptz(6)
  archiveWarningSentAt    DateTime?   @map("archive_warning_sent_at") @db.Timestamptz(6)
  lastActivityAt          DateTime    @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  cancelledAt             DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason      String?     @map("cancellation_reason") @db.VarChar(1000)
  clonedFromEventId       String?     @map("cloned_from_event_id") @db.Uuid
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  createdByUserId         String      @map("created_by_user_id") @db.Uuid
  version                 Int         @default(1)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization      @relation("fk_events__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_events__organizations")
  coordinatorMembership Membership?       @relation("fk_events__memberships", fields: [organizationId, coordinatorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_events__memberships")
  template              EventTemplate?    @relation("fk_events__event_templates", fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_events__event_templates")
  clonedFromEvent       Event?            @relation("fk_events__events", fields: [organizationId, clonedFromEventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_events__events")
  events                Event[]           @relation("fk_events__events")
  eventCategories       EventCategory[]   @relation("fk_event_categories__events")
  eventAssignments      EventAssignment[] @relation("fk_event_assignments__events")
  quotations            Quotation[]       @relation("fk_quotations__events")

  @@unique([organizationId, id], map: "uq_events__organization_id_id")
  @@index([organizationId, eventDate, status], map: "ix_events__organization_id_event_date_status")
  @@index([organizationId, coordinatorMembershipId, eventDate], map: "ix_events__organization_id_coordinator_membership_id_event_date")
  @@index([startsAtUtc], where: raw("status = ANY (ARRAY['COTIZADO'::event_status, 'ENVIADO'::event_status])"), map: "ix_events__start_job")
  @@index([lastActivityAt], where: raw("status = 'BORRADOR' AND archived_at IS NULL"), map: "ix_events__inactive_drafts")
  @@map("events")
}

/// TDD §4.2.5 y §4.3.5. Fuente: SRS-EVT-003; SRS-EVT-005; DDD §4.5
/// Servicios requeridos del evento, copiados de la plantilla o de un clon y editables antes de cotizar; se reemplazan en bloque.
// SQL-520 RLS (migración 20, TDD §5.2)
model EventCategory {
  id                  String   @id(map: "pk_event_categories") @default(uuid(7)) @db.Uuid
