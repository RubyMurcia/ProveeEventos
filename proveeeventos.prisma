// ===== Módulo 01: identity-access (TDD §4.2.1) =====

/// TDD §4.2.1 y §4.3.1. Fuente: DDD §4.2; SRS-AUTH-003; OpenAPI CurrentUser
/// Identidad interna de cada persona, vinculada a Auth0. Es global: puede tener membresías en varias empresas o un perfil de proveedor.
// SQL-020 CHECK: ck_users__suspension
model User {
  id               String     @id(map: "pk_users") @default(uuid(7)) @db.Uuid
  authSubject      String     @map("auth_subject")
  email            String     @db.Citext
  displayName      String?    @map("display_name") @db.VarChar(160)
  phone            String?    @db.VarChar(40)
  status           UserStatus @default(PENDIENTE_VERIFICACION_EMAIL)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  suspendedAt      DateTime?  @map("suspended_at") @db.Timestamptz(6)
  suspensionReason String?    @map("suspension_reason") @db.VarChar(1000)
  anonymizedAt     DateTime?  @map("anonymized_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userGlobalRoles         UserGlobalRole[]         @relation("fk_user_global_roles__users")
  consentRecords          ConsentRecord[]          @relation("fk_consent_records__users")
  memberships             Membership[]             @relation("fk_memberships__users")
  provider                Provider?                @relation("fk_providers__users")
  notifications           Notification[]           @relation("fk_notifications__users")
  notificationPreferences NotificationPreference[] @relation("fk_notification_preferences__users")
  dataSubjectRequests     DataSubjectRequest[]     @relation("fk_data_subject_requests__users")

  @@unique([email], map: "uq_users__email")
  @@unique([authSubject], map: "uq_users__auth_subject")
  @@map("users")
}

/// TDD §4.2.1 y §4.3.1. Fuente: DDD §4.2; DEC-022
/// Roles globales de un usuario, con su revocación.
// SQL-420 trigger: trg_user_global_roles__sin_borrado
model UserGlobalRole {
  id              String     @id(map: "pk_user_global_roles") @default(uuid(7)) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  role            GlobalRole
  grantedByUserId String?    @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?    @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("fk_user_global_roles__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_global_roles__users")

  @@unique([userId, role], where: raw("revoked_at IS NULL"), map: "uq_user_global_roles__user_id_role")
  @@map("user_global_roles")
}

/// TDD §4.2.1 y §4.3.1. Fuente: SRS-NFR-PRIV-001; SRS-NFR-PRIV-006; DEC-003
/// Evidencia de cada aceptación de términos y de la política de datos.
// SQL-021 CHECK: ck_consent_records__sujeto
// SQL-421 trigger: trg_consent_records__inmutable
model ConsentRecord {
  id            String             @id(map: "pk_consent_records") @default(uuid(7)) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  subjectType   ConsentSubjectType @map("subject_type")
  /// Referencia lógica a organizations.id (ADR-DATA-03): Polimórfica (empresa o proveedor) y contra la matriz: `identity-access` no depende de nadie
  subjectId     String?            @map("subject_id") @db.Uuid
  consentType   ConsentType        @map("consent_type")
  noticeVersion String             @map("notice_version")
  acceptedAt    DateTime           @map("accepted_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("fk_consent_records__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_consent_records__users")

  @@index([userId, acceptedAt], map: "ix_consent_records__user_id_accepted_at")
  @@map("consent_records")
}

// ===== Módulo 02: organizations (TDD §4.2.2) =====

/// TDD §4.2.2 y §4.3.2. Fuente: DDD §5.2; SRS-AUTH-001; SRS-TEN-005
/// Empresa organizadora. Es el tenant: su `id` es el valor de `organization_id` en el resto del modelo.
// SQL-030 CHECK: ck_organizations__suspension
// SQL-510 RLS (migración 20, TDD §5.2)
model Organization {
  id                 String             @id(map: "pk_organizations") @default(uuid(7)) @db.Uuid
  legalName          String             @map("legal_name") @db.VarChar(200)
  tradeName          String?            @map("trade_name") @db.VarChar(200)
  taxId              String             @map("tax_id") @db.VarChar(40)
  contactName        String             @map("contact_name") @db.VarChar(160)
  contactEmail       String             @map("contact_email") @db.Citext
  phone              String             @db.VarChar(40)
  city               String             @db.VarChar(120)
  status             OrganizationStatus @default(PENDIENTE_VERIFICACION_EMAIL)
  suspendedAt        DateTime?          @map("suspended_at") @db.Timestamptz(6)
  suspensionReason   String?            @map("suspension_reason") @db.VarChar(1000)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor (ADR-DATA-03)
  registeredByUserId String             @map("registered_by_user_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships       Membership[]       @relation("fk_memberships__organizations")
  organizationPlans OrganizationPlan[] @relation("fk_organization_plans__organizations")
  planUsageCounters PlanUsageCounter[] @relation("fk_plan_usage_counters__organizations")
  eventTemplates    EventTemplate[]    @relation("fk_event_templates__organizations")
  whatsappTemplates WhatsappTemplate[] @relation("fk_whatsapp_templates__organizations")
  events            Event[]            @relation("fk_events__organizations")
  bookings          Booking[]          @relation("fk_bookings__organizations")
  rfqItems          RfqItem[]          @relation("fk_rfq_items__organizations")
  quickQuotations   QuickQuotation[]   @relation("fk_quick_quotations__organizations")
  notifications     Notification[]     @relation("fk_notifications__organizations")

  @@unique([taxId], map: "uq_organizations__tax_id")
  @@map("organizations")
}

/// TDD §4.2.2 y §4.3.2. Fuente: DDD §5.3; SRS-AUTH-006; SRS-AUTH-009
/// Vínculo de una persona con una empresa y su rol. Existe desde la invitación, antes de que haya usuario (H-11).
// SQL-031 CHECK: ck_memberships__usuario
// SQL-511 RLS (migración 20, TDD §5.2)
model Membership {
  id             String           @id(map: "pk_memberships") @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  email          String           @db.Citext
  displayName    String?          @map("display_name") @db.VarChar(160)
  role           MembershipRole
  status         MembershipStatus @default(INVITADO)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(6)
  removedAt      DateTime?        @map("removed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                       Organization        @relation("fk_memberships__organizations", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_memberships__organizations")
  user                               User?               @relation("fk_memberships__users", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_memberships__users")
  invitations                        Invitation[]        @relation("fk_invitations__memberships")
  ownershipTransfersAsFromMembership OwnershipTransfer[] @relation("fk_ownership_transfers__memberships__from_membership_id")
  ownershipTransfersAsToMembership   OwnershipTransfer[] @relation("fk_ownership_transfers__memberships__to_membership_id")
  events                             Event[]             @relation("fk_events__memberships")
  eventAssignments                   EventAssignment[]   @relation("fk_event_assignments__memberships")

  @@unique([organizationId, id], map: "uq_memberships__organization_id_id")
  @@unique([organizationId, userId], where: raw("removed_at IS NULL AND user_id IS NOT NULL"), map: "uq_memberships__active_user")
  @@unique([organizationId, email], where: raw("removed_at IS NULL"), map: "uq_memberships__active_email")
  @@unique([organizationId], where: raw("role = 'PROPIETARIO' AND removed_at IS NULL"), map: "uq_memberships__single_owner")
  @@index([organizationId, createdAt, id], map: "ix_memberships__organization_id_created_at_id")
  @@index([userId, status], map: "ix_memberships__user_id_status")
  @@map("memberships")
}

/// TDD §4.2.2 y §4.3.2. Fuente: DDD §4.3; SRS-AUTH-006
/// Invitación de un solo uso; solo guarda el hash del token.
// SQL-032 CHECK: ck_invitations__token
// SQL-512 RLS (migración 20, TDD §5.2)
model Invitation {
  id               String           @id(map: "pk_invitations") @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  membershipId     String           @map("membership_id") @db.Uuid
  role             MembershipRole
  email            String           @db.Citext
  tokenNonce       Bytes            @map("token_nonce")
  tokenHash        Bytes            @map("token_hash")
  secretKeyVersion Int              @map("secret_key_version") @db.SmallInt
  status           InvitationStatus @default(PENDIENTE)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership Membership @relation("fk_invitations__memberships", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_invitations__memberships")

  @@unique([tokenHash], map: "uq_invitations__token_hash")
  @@unique([membershipId], where: raw("status = 'PENDIENTE'"), map: "uq_invitations__pending")
  @@index([organizationId, membershipId], map: "ix_invitations__organization_id_membership_id")
  @@index([expiresAt], where: raw("status = 'PENDIENTE'"), map: "ix_invitations__expiry")
  @@map("invitations")
}

/// TDD §4.2.2 y §4.3.2. Fuente: DDD §4.3; SRS-AUTH-009
/// Transferencia de propiedad pendiente de aceptación (E2).
// SQL-033 CHECK: ck_ownership_transfers__partes
// SQL-513 RLS (migración 20, TDD §5.2)
model OwnershipTransfer {
  id                String                  @id(map: "pk_ownership_transfers") @default(uuid(7)) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  fromMembershipId  String                  @map("from_membership_id") @db.Uuid
  toMembershipId    String                  @map("to_membership_id") @db.Uuid
  status            OwnershipTransferStatus @default(PENDIENTE)
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(6)
  /// Referencia lógica a users.id (ADR-DATA-03): Actor
  requestedByUserId String                  @map("requested_by_user_id") @db.Uuid
  respondedAt       DateTime?               @map("responded_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromMembership Membership @relation("fk_ownership_transfers__memberships__from_membership_id", fields: [organizationId, fromMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ownership_transfers__memberships__from_membership_id")
  toMembership   Membership @relation("fk_ownership_transfers__memberships__to_membership_id", fields: [organizationId, toMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ownership_transfers__memberships__to_membership_id")

  @@unique([organizationId], where: raw("status = 'PENDIENTE'"), map: "uq_ownership_transfers__pending")
  @@index([organizationId, fromMembershipId], map: "ix_ownership_transfers__organization_id_from_membership_id")
  @@index([organizationId, toMembershipId], map: "ix_ownership_transfers__organization_id_to_membership_id")
  @@index([expiresAt], where: raw("status = 'PENDIENTE'"), map: "ix_ownership_transfers__expiry")
  @@map("ownership_transfers")
}

/// TDD §4.2.2 y §4.3.2. Fuente: SRS-TEN-004; DEC-029; PRD §14.1
/// Definición versionada de cada plan, con precio y límites. Un límite nulo es ilimitado.
// SQL-034 CHECK: ck_plans__limites
// SQL-035 CHECK: ck_plans__precio
// SQL-036 CHECK: ck_plans__vigencia
model Plan {
  id                   String    @id(map: "pk_plans") @default(uuid(7)) @db.Uuid
