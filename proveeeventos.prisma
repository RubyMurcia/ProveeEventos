/// TDD §4.2.4 y §4.3.4. Fuente: DDD §5.4; SRS-CAT-006; DEC-010
/// Paquete de servicio con precio, condiciones, modalidad y tratamiento de impuestos.
// SQL-086 CHECK: ck_service_packages__precios
// SQL-087 CHECK: ck_service_packages__impuestos
// SQL-088 CHECK: ck_service_packages__capacidad
// SQL-095 CHECK: ck_service_packages__listas
model ServicePackage {
  id                   String          @id(map: "pk_service_packages") @default(uuid(7)) @db.Uuid
  providerId           String          @map("provider_id") @db.Uuid
  categoryId           String          @map("category_id") @db.Uuid
  subtypeId            String          @map("subtype_id") @db.Uuid
  name                 String          @db.VarChar(160)
  description          String?         @db.VarChar(4000)
