{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev:api": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & exec node --watch --enable-source-maps dist/bootstrap/server.js",
    "dev:worker": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & exec node --watch --enable-source-maps dist/bootstrap/worker.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.81.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
